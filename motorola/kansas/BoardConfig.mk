# Additional binaries & libraries needed for recovery--> add to build
TARGET_RECOVERY_DEVICE_MODULES += \
    libkeymaster4 \
    libpuresoftkeymasterdevice \
    ashmemd_aidl_interface-cpp \
    libashmemd_client \
    android.system.keystore2-V3-ndk \
    android.system.keystore2-V4-ndk \
    android.hardware.security.keymint-V3-ndk \
    libresetprop

# Hack: prevent anti rollback
PLATFORM_SECURITY_PATCH := 2099-12-31
VENDOR_SECURITY_PATCH := 2099-12-31
PLATFORM_VERSION := 16.1.0

# TWRP Configuration
TW_THEME := portrait_hdpi
TW_EXTRA_LANGUAGES := false
TW_SCREEN_BLANK_ON_BOOT := true
TW_INPUT_BLACKLIST := "hbtp_vm"
TW_USE_TOOLBOX := true
TW_OEM_BUILD := true
TW_INCLUDE_REPACKTOOLS := true
# Exlude encrytpion of backups need with fde so fbe flag compiles
TW_EXCLUDE_ENCRYPTED_BACKUPS := true
# Disable old fde so new fbe can be used in flag
TW_INCLUDE_CRYPTO_FDE := false
# Use Newer DUSE_FSCRYPT_POLICY_V2
TW_USE_FSCRYPT_POLICY := 2
# Crypto--> add to build
TW_INCLUDE_CRYPTO := true
TW_INCLUDE_CRYPTO_FBE := true
TW_INCLUDE_FBE_METADATA_DECRYPT := true
TW_INCLUDE_LIBRESETPROP := true