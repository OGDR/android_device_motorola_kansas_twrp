on early-init
    mkdir /dev/block/bootdevice 0755 root root
    symlink /dev/block/by-name /dev/block/bootdevice/by-name
    mkdir /sys/kernel/tracing 0755 root root
    mount tracefs tracefs /sys/kernel/tracing

on init
    mkdir /mnt/vendor/persist 0771 system system
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"
    setprop sys.usb.ffs.aio_compat 1
    setprop crypto.ready 1
    mkdir /tmp/misc 0755 root root
    mkdir /tmp/misc/keystore 0700 system system

on post-fs
    insmod /lib/modules/sensors_class.ko
    insmod /lib/modules/focaltech_0flash_mmi_v3.ko
    insmod /lib/modules/nova_0flash_mmi_v3.ko
    exec u:r:recovery:s0 root root -- /system/bin/mtk_plpath_utils
    start mtk.plpath.utils.link
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/by-name/preloader_b
    symlink /dev/block/by-name/preloader_a /dev/block/by-name/preloader_emmc_a
    symlink /dev/block/by-name/preloader_b /dev/block/by-name/preloader_emmc_b
    symlink /dev/block/by-name/preloader_a /dev/block/by-name/preloader_ufs_a
    symlink /dev/block/by-name/preloader_b /dev/block/by-name/preloader_ufs_b
    symlink /dev/block/mapper/pl_a /dev/block/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/by-name/preloader_raw_b
    wait /dev/block/by-name/persist 5
    mkdir /mnt/vendor/persist 0771 system system
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist
    mkdir /mnt/vendor/persist/mcRegistry 0771 system system
    mkdir /mnt/vendor/persist/mobicore 0770 system system
    chown system system /mnt/vendor/persist
    chown system system /mnt/vendor/persist/mcRegistry
    chown system system /mnt/vendor/persist/mobicore
    chmod 0771 /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist/mcRegistry
    chmod 0770 /mnt/vendor/persist/mobicore
    restorecon /mnt/vendor/persist
    restorecon /mnt/vendor/persist/mcRegistry
    restorecon /mnt/vendor/persist/mobicore
    mkdir /mnt/vendor/tzapp 0755 root root
    mount ext4 /dev/block/by-name/tzapp_a /mnt/vendor/tzapp
    restorecon_recursive /system
    restorecon_recursive /vendor
    start trustlet_backup

service trustlet_backup /system/bin/init.mmi.backup.trustlet.sh
    class main
    user root
    group root system
    oneshot
    disabled
    seclabel u:r:recovery:s0

on property:init.svc.trustlet_backup=stopped
    start mobicore

on boot
    start boot-hal-1-2
    start health-hal-2-1
    setprop sys.usb.config adb
    start vendor.gatekeeper-1-0

on property:init.svc.mobicore=running
    start tee-1-1

on property:init.svc.tee-1-1=running
    start vendor.keymint-trustonic

on property:init.svc.vendor.keymint-trustonic=running
    start keystore2

service tee-1-1 /vendor/bin/hw/vendor.trustonic.tee@1.1-service
    class hal
    user system
    group system
    seclabel u:r:recovery:s0

service vendor.keymint-trustonic /vendor/bin/hw/android.hardware.security.keymint@2.0-service.trustonic
    class early_hal
    user system
    group system
    seclabel u:r:recovery:s0

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    class hal
    user system
    group system
    seclabel u:r:recovery:s0

service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class core
    user system
    group system
    seclabel u:r:recovery:s0