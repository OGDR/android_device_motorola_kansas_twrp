# Allow vendor_init to work on rootfs in recovery
allow vendor_init rootfs:dir { write add_name create setattr };

# Allow creating the directories it needs
#allow vendor_init system_data_file:dir { create write add_name setattr };
allow vendor_init vendor_data_file:dir { create write add_name setattr };

# Specific for the mcRegistry / key_provisioning paths
allow vendor_init labeledfs:dir { create write add_name setattr };
